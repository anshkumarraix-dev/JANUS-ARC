{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "description": "Echo Show 8 landscape non-intrusive reminder for elder scheduled routine windows.",
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "item": {
      "type": "Container",
      "width": "100%",
      "height": "100%",
      "backgroundColor": "#0B0F19",
      "paddingLeft": "48dp",
      "paddingRight": "48dp",
      "paddingTop": "36dp",
      "paddingBottom": "36dp",
      "justifyContent": "spaceBetween",
      "items": [
        {
          "type": "Container",
          "direction": "row",
          "alignItems": "center",
          "justifyContent": "spaceBetween",
          "items": [
            {
              "type": "Text",
              "text": "${payload.header}",
              "fontSize": "26dp",
              "fontWeight": "700",
              "color": "#F59E0B",
              "maxLines": 1
            },
            {
              "type": "Frame",
              "backgroundColor": "#451A03",
              "borderRadius": "8dp",
              "paddingLeft": "16dp",
              "paddingRight": "16dp",
              "paddingTop": "6dp",
              "paddingBottom": "6dp",
              "item": {
                "type": "Text",
                "text": "Gentle Check-in",
                "fontSize": "24dp",
                "fontWeight": "600",
                "color": "#FCD34D"
              }
            }
          ]
        },
        {
          "type": "Frame",
          "backgroundColor": "#291504",
          "borderColor": "#F59E0B",
          "borderWidth": "2dp",
          "borderRadius": "20dp",
          "paddingLeft": "36dp",
          "paddingRight": "36dp",
          "paddingTop": "28dp",
          "paddingBottom": "28dp",
          "item": {
            "type": "Container",
            "direction": "column",
            "justifyContent": "center",
            "items": [
              {
                "type": "Text",
                "text": "${payload.routineTitle}",
                "fontSize": "42dp",
                "fontWeight": "800",
                "color": "#FBBF24",
                "maxLines": 1
              },
              {
                "type": "Text",
                "text": "${payload.windowTime}",
                "fontSize": "30dp",
                "fontWeight": "600",
                "color": "#FFFFFF",
                "maxLines": 2
              }
            ]
          }
        },
        {
          "type": "Frame",
          "backgroundColor": "#1E293B",
          "borderRadius": "14dp",
          "paddingLeft": "24dp",
          "paddingRight": "24dp",
          "paddingTop": "14dp",
          "paddingBottom": "14dp",
          "item": {
            "type": "Text",
            "text": "${payload.voicePrompt}",
            "fontSize": "26dp",
            "fontWeight": "700",
            "color": "#FEF08A",
            "textAlign": "center",
            "maxLines": 1
          }
        }
      ]
    }
  }
}